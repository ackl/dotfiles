# send window to desktop and follow focus
# shift + cmd - z : yabai -m window --space next; yabai -m space --focus next
# shift + cmd - 2 : yabai -m window --space  2; yabai -m space --focus 2

# focus monitor
# ctrl + alt - z  : yabai -m display --focus prev
# ctrl + alt - 3  : yabai -m display --focus 3

# send window to monitor and follow focus
# ctrl + cmd - 1  : yabai -m window --display 1; yabai -m display --focus 1

# move floating window
# shift + ctrl - a : yabai -m window --move rel:-20:0
# shift + ctrl - s : yabai -m window --move rel:0:20

# increase window size
ctrl + shift - i : yabai -m window --resize bottom:0:-20

# decrease window size
ctrl + shift - k : yabai -m window --resize top:0:20

# set insertion point in focused container
# ctrl + alt - h : yabai -m window --insert west

# toggle window zoom
alt - f : yabai -m window --toggle zoom-fullscreen

# toggle window split type
alt - r : yabai -m window --toggle split

# float / unfloat window and center on screen

# toggle sticky(+float), picture-inshi-picture
alt - p : yabai -m window --toggle sticky --toggle pip

# ctrl - down : yabai<M-D-e><M-D-a> -m window --focus stack.next || yabai -m window --focus south
# ctrl - down : yabai -m window --focus stack.next || yabai -m window --focus south
# ctrl - up : yabai -m window --focus stack.prev || yabai -m window --focus north
# ctrl + alt - left : yabai -m window --focus west
# ctrl + alt - right : yabai -m window --focus east

# open kitty terminal in home directory
cmd - return : kitty --single-instance -d ~ $(pwd)



cmd + shift - h : yabai -m window --warp west; $(yabai -m window --display west; yabai -m display --focus west)
cmd + shift - l : yabai -m window --warp east; $(yabai -m window --display east; yabai -m display --focus east)
cmd + shift - j : yabai -m window --warp south; $(yabai -m window --display south; yabai -m display --focus south)
cmd + shift - k : yabai -m window --warp north; $(yabai -m window --display north; yabai -m display --focus north)
cmd - j : yabai -m window --focus south; yabai -m display --focus south || yabai -m window --focus stack.next || yabai -m window --focus south
cmd - k : yabai -m window --focus north; yabai -m display --focus north

# alt - t : yabai -m window --toggle float
cmd + shift - space : yabai -m window --toggle float --grid 9:9:1:1:7:7

alt - e : yabai -m space --layout bsp
alt - s : yabai -m space --layout stack

cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6

# move window to space and follow focus
cmd + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
cmd + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
cmd + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
cmd + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
cmd + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5
cmd + shift - 6 : yabai -m window --space 6; yabai -m space --focus 6

# focus windows and spaces
cmd - h : yabai -m window --focus west; yabai -m display --focus west

cmd - l [
    *          : yabai -m window --focus east; yabai -m display --focus east
    "Brave Browser"    ~
]
cmd - 0x29 [
    *          ~
    "Brave Browser"    : yabai -m window --focus east; yabai -m display --focus east
]

shift + alt - left : yabai -m window --resize left:-50:0; \
                  yabai -m window --resize right:-50:0
shift + alt - down : yabai -m window --resize bottom:0:50; \
                  yabai -m window --resize top:0:50
shift + alt - up : yabai -m window --resize top:0:-50; \
                  yabai -m window --resize bottom:0:-50
shift + alt - right : yabai -m window --resize right:50:0; \
                  yabai -m window --resize left:50:-1
