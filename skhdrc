# balance size of windows
cmd + shift - 0 : yabai -m space --balance

# mannualy restart the yabai service (useful sometimes when it gets buggy)
cmd + shift - r : /usr/local/bin/yabai-restart

# toggle window zoom
alt - f : yabai -m window --toggle zoom-fullscreen

# toggle window split type
alt - r : yabai -m window --toggle split

# float / unfloat window and center on screen
cmd + shift - space : yabai -m window --toggle float --grid 9:9:1:1:7:7

# toggle sticky(+float), picture-in-picture
alt - p : yabai -m window --toggle pip --toggle sticky

cmd - return :  osascript -e 'tell application "kitty" to activate' -e 'tell application "System Events" to keystroke "n" using {command down}'


.define yabai_focus : yabai -m window --focus {{1}; yabai -m display --focus {{1}}
.define yabai_swap : yabai -m window --swap {{1}}; (yabai -m window --display {{1}} && yabai -m display --focus {{1}})
.define yabai_warp : yabai -m window --warp {{1}}; (yabai -m window --display {{1}} && yabai -m display --focus {{1}})

.define yabai_move : yabai -m window --space {{1}}
.define yabai_move_wfocus : yabai -m window --space {{1}}; yabai -m space --focus {{1}}

.define resize_window : yabai -m window --resize {{1}}:{{2}}:{{3}}
.define toggle_scratchpad : yabai -m window --toggle {{1}} || open -a "{{2}}"

cmd + ctrl - h : @resize_window("left", "-20", "0")
cmd + ctrl - l : @resize_window("right", "20", "0")

cmd + shift - h : @yabai_warp("west")
cmd + shift - j : @yabai_warp("south")
cmd + shift - k : @yabai_warp("north")
cmd + shift - l : @yabai_warp("east")

alt + shift - h : @yabai_warp("west")
alt + shift - j : @yabai_warp("south")
alt + shift - k : @yabai_warp("north")
alt + shift - l : @yabai_warp("east")

cmd - h : @yabai_focus("west")
cmd - j : @yabai_focus("south")
cmd - k : @yabai_focus("north")
cmd - l : @yabai_focus("east")

alt + shift - 1 : @yabai_move("1")
alt + shift - 2 : @yabai_move("2") 
alt + shift - 3 : @yabai_move("3")
alt + shift - 4 : @yabai_move("4")
alt + shift - 5 : @yabai_move("5")
alt + shift - 6 : @yabai_move("6") 

cmd + shift - 1 : @yabai_move_wfocus("1")
cmd + shift - 2 : @yabai_move_wfocus("2") 
cmd + shift - 3 : @yabai_move_wfocus("3")
cmd + shift - 4 : @yabai_move_wfocus("4")
cmd + shift - 5 : @yabai_move_wfocus("5")
cmd + shift - 6 : @yabai_move_wfocus("6") 
